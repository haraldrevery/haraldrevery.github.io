# ============================================================================
#  STATUS: THIS FILE IS NOT CURRENTLY IN EFFECT.  Read before trusting it.
# ============================================================================
#
#  The site is served by GITHUB PAGES (repo haraldrevery.github.io, see
#  update_to_git_guide.md) with Cloudflare in front as a proxy/CDN. GitHub Pages
#  does not read `_headers` -- that is a Cloudflare Pages / Workers-Assets
#  feature. So is `wrangler.jsonc`; neither is part of the live deploy.
#
#  Verify at any time:
#      curl -sSI https://haraldrevery.com/ | grep -i 'content-security-policy'
#  The live CSP does NOT contain the object-src / base-uri / frame-ancestors
#  directives below, which proves this file is not being applied. The live
#  headers are set by Cloudflare rules in the dashboard, and the live CSP is
#  looser than this file (it additionally allows static.cloudflareinsights.com,
#  cdn.tailwindcss.com, cdnjs.cloudflare.com and img-src https:) -- nothing on
#  the site actually needs those, every script/style/font/image is self-hosted.
#
#  Caching is ALREADY HANDLED and does not need fixing here. Measured live:
#      /fonts/*, /main.css, /photos/*  ->  Cache-Control: max-age=16070400 (186d),
#                                          cf-cache-status: HIT
#      *.html                          ->  Cache-Control: max-age=600
#  Any change to caching must be made in the Cloudflare dashboard (Cache Rules),
#  NOT here. Do not "fix" caching by editing this file -- it will do nothing.
#
#  This file is kept because it is a correct, ready-to-use config IF the site is
#  ever migrated to Cloudflare Workers static assets (`wrangler deploy`). Two
#  things to check on that day:
#    1. The CSP below is the tighter one. Confirm no page has picked up an
#       external script/image since, or it will start being blocked.
#    2. The Cache-Control values below are chosen to match, not regress, the
#       186-day max-age the site gets today.
#
#  Docs: https://developers.cloudflare.com/workers/static-assets/headers/
# ============================================================================

# ---------------------------------------------------------------------------
# Security headers (union of what every page on the site actually uses):
#   - script 'unsafe-inline'  -> inline event handlers on interactive notebook pages
#   - script 'unsafe-eval'    -> Alpine.js and math.js evaluate expressions
#   - style  'unsafe-inline'  -> the many inline style="" attributes
#   - img/media data: blob:   -> clock canvas + jsPDF (event_card)
#   - everything else 'self'  -> all JS/CSS/fonts/audio are self-hosted
#   - object-src 'none', base-uri 'self', frame-ancestors 'self' -> hardening
# If you later embed a YouTube/Spotify player or add Cloudflare Web Analytics,
# those origins must be added (frame-src / script-src / connect-src).
# ---------------------------------------------------------------------------
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# ---------------------------------------------------------------------------
# Caching. Only meaningful under Workers assets -- see the STATUS block above.
#
# `immutable` is used ONLY for fonts, whose filenames never change content
# without changing name. It is deliberately NOT used for CSS or media, which are
# rebuilt/replaced in place (main.css is regenerated by Tailwind on every build),
# because immutable tells the browser never to revalidate for the whole year.
# ---------------------------------------------------------------------------

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Media is content-stable in practice but replaceable by name; a long max-age
# matches today's live 186 days, and Cloudflare can be purged on replacement.
/photos/*
  Cache-Control: public, max-age=16070400
/artcover/*
  Cache-Control: public, max-age=16070400
/audio/*
  Cache-Control: public, max-age=16070400
/music/*
  Cache-Control: public, max-age=16070400
/video/*
  Cache-Control: public, max-age=16070400
/gif/*
  Cache-Control: public, max-age=16070400
/graphics/*
  Cache-Control: public, max-age=16070400
/svg/*
  Cache-Control: public, max-age=16070400
/download/*
  Cache-Control: public, max-age=16070400

# Built CSS: unhashed filenames rewritten by every Tailwind build, so this must
# stay short enough that a redeploy is visible without a hard refresh.
/*.css
  Cache-Control: public, max-age=86400, must-revalidate

# HTML and the generated JSON feeds must always revalidate, or a published post
# can sit stale in a browser cache. Matches the live max-age=600 in spirit.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/search-index.json
  Cache-Control: public, max-age=0, must-revalidate
