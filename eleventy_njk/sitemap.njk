---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
site_url: "https://haraldrevery.com"
# Pages that are not in a collection, so they must be listed here. `loc` matches
# each page's <link rel="canonical">.
#
# <lastmod> is the date the page's CONTENT last changed, from two things:
#   sources  what the page's text is built from. When their content changes,
#            the page gets that build's date (sitemap.11tydata.js explains how,
#            and why not file modification times). Never nav/footer/base: chrome
#            every page shares is not a content change.
#   newest   collections the page LISTS; their newest item date counts too, so
#            the home page moves when a post or release is added.
# The later of the two wins. A new hand-written page must be added here with its
# sources, or it is missing from the sitemap.
staticPages:
  - loc: "/"
    sources: ["eleventy_njk/home.njk"]
    newest: [notebook_posts, releases]
    changefreq: weekly
    priority: "1.0"
  - loc: "/music"
    sources: ["eleventy_njk/music.njk"]
    changefreq: weekly
    priority: "0.9"
  - loc: "/about"
    sources: ["eleventy_njk/about.njk"]
    changefreq: monthly
    priority: "0.8"
  - loc: "/contact"
    sources: ["eleventy_njk/contact.njk"]
    changefreq: monthly
    priority: "0.8"
  - loc: "/notebook"
    sources: ["eleventy_njk/blog.njk"]
    newest: [notebook_posts]
    changefreq: weekly
    priority: "0.8"
  - loc: "/download"
    # The file list is scanned off disk; its output is what visitors see change.
    sources: ["eleventy_njk/download.njk", { data: "eleventy_njk/download.11tydata.js" }]
    changefreq: monthly
    priority: "0.6"
  - loc: "/legal"
    sources:
      - "input_legal/legal.md"
      - "input_legal/input_legal.11tydata.js"
      - "input_legal/licenses"
      - "eleventy_settings/legal.njk"
      - "eleventy_settings/license_blocks.njk"
    changefreq: yearly
    priority: "0.5"
  # Standalone apps. Each is where one of redirects.njk's old /notebook_pages/
  # addresses now points, so each is a permanent page that should be listed.
  # Their text is the page itself; the JS/CSS behind them is not a content change.
  - loc: "/clock/"
    sources: ["clock/index.html"]
    changefreq: monthly
    priority: "0.6"
  - loc: "/h/1dgraph"
    sources: ["h/1dgraph.html"]
    changefreq: monthly
    priority: "0.5"
  - loc: "/h/2dphaseportrait"
    sources: ["h/2dphaseportrait.html"]
    changefreq: monthly
    priority: "0.5"
  - loc: "/revery_notebook/"
    sources: ["revery_notebook/index.html"]
    changefreq: monthly
    priority: "0.5"
  - loc: "/rvry_ascii/rvry_ascii"
    sources: ["rvry_ascii/rvry_ascii.html"]
    changefreq: monthly
    priority: "0.5"
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for sp in staticPages %}
{%- set dates = [] %}
{%- set own = sitemapLastmod(sp.loc, sp.sources) %}
{%- if own %}{% set pushed = dates.push(own) %}{% endif %}
{%- for c in (sp.newest or []) %}{% if collections[c] and collections[c].length %}{% set pushed = dates.push(collections[c] | newestDate | isoDate) %}{% endif %}{% endfor %}
  <url>
    <loc>{{ site_url }}{{ sp.loc }}</loc>
{% if dates.length %}    <lastmod>{{ dates | sort | last }}</lastmod>
{% endif %}    <changefreq>{{ sp.changefreq }}</changefreq>
    <priority>{{ sp.priority }}</priority>
  </url>
{%- endfor %}
{#- A post edited after publication carries `updated` in its front matter;
    base.njk already prefers it for article:modified_time, so <lastmod> must
    agree or the sitemap advertises a staler date than the page itself. -#}
{%- for post in collections.notebook_posts %}
  <url>
    <loc>{{ site_url }}{{ post.url | cleanUrl }}</loc>
{% set lm = (post.data.updated or post.date) | isoDate %}{% if lm %}    <lastmod>{{ lm }}</lastmod>
{% endif %}    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{#- Pages 2+ of the paginated Notebook index (eleventy_njk/blog.njk, size 40).
    Page 1 is /notebook and is listed in staticPages above. Under 40 posts this
    loop emits nothing; without it, every page past the first would be
    unlisted the moment the notebook outgrows one page. -#}
{%- for p in collections.notebook_posts | notebookIndexPages %}
  <url>
    <loc>{{ site_url }}/notebook_pages/notebook-page-{{ p }}</loc>
    <lastmod>{{ collections.notebook_posts | newestDate | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor %}
{#- <lastmod> for a generated index is the newest date of what it LISTS, never
    buildDate: buildDate changes every day the site is rebuilt, which rewrites
    sitemap.xml with no content change (git churn) and trains crawlers to
    distrust the field. Same rule as the staticPages content dates above. -#}
{%- for t in collections.paginatedTagData %}
  <url>
    <loc>{{ site_url }}/notebook_pages/tag-{{ t.tag | slugify }}{% if t.pageNumber > 0 %}-page-{{ t.pageNumber + 1 }}{% endif %}</loc>
    <lastmod>{{ t.posts | newestDate | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
{%- if collections.releases.length %}
  <url>
    <loc>{{ site_url }}/discography</loc>
    <lastmod>{{ collections.releases | newestDate | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
{%- endif %}
{#- `r.dateISO`, not `r.date | isoDate`: the raw JSON dates are unpadded
    ("2019-5-14"), which parse as LOCAL midnight and then format one day early
    in UTC -- this listed forest_shine as 2019-05-13 and remixes as 2014-12-31,
    disagreeing with the datePublished the release page's own JSON-LD emits. -#}
{%- for r in collections.releases %}
  <url>
    <loc>{{ site_url }}{{ r.url | cleanUrl }}</loc>
{% set lm = r.dateISO %}{% if lm %}    <lastmod>{{ lm }}</lastmod>
{% endif %}    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
</urlset>
