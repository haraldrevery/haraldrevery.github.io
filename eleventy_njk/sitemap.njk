---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
site_url: "https://haraldrevery.com"
# Pages that are not in a collection, so they must be listed here. `loc` matches
# each page's <link rel="canonical">. `file` is the SOURCE whose mtime gives
# <lastmod> — for a generated page that is its .njk, never the built output:
# Eleventy rewrites output on every build, which would churn <lastmod> forever.
staticPages:
  - loc: "/"
    file: "eleventy_njk/home.njk"
    changefreq: weekly
    priority: "1.0"
  - loc: "/music"
    file: "eleventy_njk/music.njk"
    changefreq: weekly
    priority: "0.9"
  - loc: "/about"
    file: "eleventy_njk/about.njk"
    changefreq: monthly
    priority: "0.8"
  - loc: "/contact"
    file: "eleventy_njk/contact.njk"
    changefreq: monthly
    priority: "0.8"
  - loc: "/notebook"
    file: "notebook.html"
    changefreq: weekly
    priority: "0.8"
  - loc: "/download"
    file: "download.html"
    changefreq: monthly
    priority: "0.6"
  - loc: "/legal"
    file: "legal.html"
    changefreq: yearly
    priority: "0.5"
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for sp in staticPages %}
  <url>
    <loc>{{ site_url }}{{ sp.loc }}</loc>
    <lastmod>{{ sp.file | fileModDate | isoDate }}</lastmod>
    <changefreq>{{ sp.changefreq }}</changefreq>
    <priority>{{ sp.priority }}</priority>
  </url>
{%- endfor %}
{#- A post edited after publication carries `updated` in its front matter;
    base.njk already prefers it for article:modified_time, so <lastmod> must
    agree or the sitemap advertises a staler date than the page itself. -#}
{%- for post in collections.notebook_posts %}
  <url>
    <loc>{{ site_url }}{{ post.url | cleanUrl }}</loc>
{% set lm = (post.data.updated or post.date) | isoDate %}{% if lm %}    <lastmod>{{ lm }}</lastmod>
{% endif %}    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{#- Pages 2+ of the paginated Notebook index (eleventy_njk/blog.njk, size 40).
    Page 1 is /notebook and is listed in staticPages above. Under 40 posts this
    loop emits nothing; without it, every page past the first would be
    unlisted the moment the notebook outgrows one page. -#}
{%- for p in collections.notebook_posts | notebookIndexPages %}
  <url>
    <loc>{{ site_url }}/notebook_pages/notebook-page-{{ p }}</loc>
    <lastmod>{{ collections.notebook_posts | newestDate | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor %}
{#- <lastmod> for a generated index is the newest date of what it LISTS, never
    buildDate: buildDate changes every day the site is rebuilt, which rewrites
    sitemap.xml with no content change (git churn) and trains crawlers to
    distrust the field. Same rule as the staticPages `file` mtimes above. -#}
{%- for t in collections.paginatedTagData %}
  <url>
    <loc>{{ site_url }}/notebook_pages/tag-{{ t.tag | slugify }}{% if t.pageNumber > 0 %}-page-{{ t.pageNumber + 1 }}{% endif %}</loc>
    <lastmod>{{ t.posts | newestDate | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
{%- if collections.releases.length %}
  <url>
    <loc>{{ site_url }}/discography</loc>
    <lastmod>{{ collections.releases | newestDate | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
{%- endif %}
{%- for r in collections.releases %}
  <url>
    <loc>{{ site_url }}{{ r.url | cleanUrl }}</loc>
{% set lm = r.date | isoDate %}{% if lm %}    <lastmod>{{ lm }}</lastmod>
{% endif %}    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
</urlset>
