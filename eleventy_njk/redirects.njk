---
# One stub page per address that used to be published (most were once in the
# sitemap) and has since moved. Each stub is an instant meta refresh plus a
# canonical to the new address, which Google treats as a permanent redirect —
# the only kind of redirect GitHub Pages can serve from the repo alone. Without
# a stub the old address is a 404, and whatever links and ranking it had are
# thrown away.
#
# Same mechanism as revery_notebook/revery_notebook.html (hand-written, older).
#
# `from` is the file written (so /notebook_pages/1dgraph and
# /notebook_pages/1dgraph.html both land on it); `to` is the new page's
# canonical URL. Generated rather than hand-placed because the README's advice
# for stale posts is to empty notebook_pages/, which would take hand-placed
# stubs with it. healthcheck.sh knows these files have no source (it skips any
# notebook_pages/ page carrying http-equiv="refresh").
#
# MOVING OR RENAMING A PUBLISHED PAGE: add a row here, rebuild, commit. Keep
# information/SETUP.md "Deploying" in step. A `from` must never be the output
# of a live page: Eleventy stops the build on a clash with a template, but it
# cannot see the verbatim copies of input_custom_html_pages/, so a stub named
# like one of those would silently replace it.
#
# /h/clock_and_date is deliberately NOT here: it is kept as a full copy of
# clock/index.html (canonical -> /clock/), by choice.
redirects:
  - from: notebook_pages/1dgraph.html
    to: /h/1dgraph
  - from: notebook_pages/2dphaseportrait.html
    to: /h/2dphaseportrait
  - from: notebook_pages/clock_and_date.html
    to: /clock/
  - from: notebook_pages/rvry_ascii.html
    to: /rvry_ascii/rvry_ascii
  - from: notebook_pages/revery_notebook_info.html
    to: /revery_notebook/
  - from: notebook_pages/things-to-do-with-llm.html
    to: /notebook_pages/things-to-do-with-llms
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<!-- Moved-page stub, generated by eleventy_njk/redirects.njk. Edit the list there. -->
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Moved - Harald Revery</title>
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
  <link rel="canonical" href="https://haraldrevery.com{{ r.to }}">
</head>
<body>
  <p><a href="{{ r.to }}">This page has moved — continue here.</a></p>
</body>
</html>
