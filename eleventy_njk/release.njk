            {% endif %}
        </div>
    </section>

    {% if release.tracklist and release.tracklist.length %}
    <!-- ============ TRACKLIST (albums / EPs) ============ -->
    <section class="release-section">

        <div class="release-divider">
            <span class="release-divider__label">Tracklist</span>
            <span class="release-divider__line"></span>
        </div>

        <ol class="tracklist">
            {% for t in release.tracklist %}
            <li class="track">
                <span class="track__index">{% if t.order < 10 %}0{% endif %}{{ t.order }}</span>
                <span class="track__title">{{ t.name }}{% if t.version %} <span class="opacity-50">({{ t.version }})</span>{% endif %}</span>
                <span class="track__meta">
                    {% if t.isrc %}<span class="track__isrc">{{ t.isrc }}</span>{% endif %}
                    <span class="track__time">{{ t.length }}</span>
                </span>
            </li>
            {% endfor %}
        </ol>
    </section>
    {% endif %}

    {% if release.video %}
    <!-- ============ VIDEO ============ -->
    <section class="mt-16 grid gap-10 md:grid-cols-2 items-center">

      <div>
        <h2 class="font-mono text-sm uppercase tracking-eyebrow opacity-50 mb-6">Video</h2>
        {% if release.video.description %}
        <p class="text-lg opacity-70">{{ release.video.description }}</p>
        {% endif %}
      </div>

      <video controls preload="none"{% if release.video.thumbnail %} poster="{{ release.video.thumbnail }}"{% endif %}
             class="w-full rounded-xl overflow-hidden shadow-2xl bg-black">
        <source src="{{ release.video.src }}" type="video/mp4">
        Your browser does not support the video element.
      </video>
    </section>
    {% endif %}

    {% if release.about %}
    <!-- ============ ABOUT / RELEASE NOTES ============ -->
    <article class="prose dark:prose-invert max-w-none mt-16">
      <h2>About the release</h2>
      {{ release.about | safe }}
    </article>
    {% endif %}


<!-- Date -->
<div class="pt-24">
  <hr>
  <div class="py-2">
    <time class="text-sm font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider" datetime="{{ release.date }}">
    {{ release.date | readableDate }}
    </time>
  </div>
</div>

</div>

<!-- Go back link -->
<div class="pt-6 page-container">
    <a href="/discography.html" class="inline-block border-b-2 border-black dark:border-white pb-1 hover:opacity-50 transition text-lg tracking-widest">
        ← DISCOGRAPHY
    </a>
</div>

<!-- Footer -->
{% include "footer.njk" %}

<!-- svg background end -->
</div>


<!-- Navigation bar reveal when scrolling down (for firefox and iOS < 15.4)) -->
<script src="/javascript/navbar_scroll_min.js"></script>


<!-- GLightbox load (powers the cover-art slider) -->
<script src="/javascript/glightbox.min.js" defer></script>
<!-- GLightbox settings -->
<script src="/javascript/glightbox_settings.js" defer></script>

</body>
</html>
