---
pagination:
  data: collections.releases
  size: 1
  alias: release
permalink: "release/{{ release.slug }}.html"
eleventyExcludeFromCollections: true
---
{% set kicker = release.kicker or ("New " + release.type + " — Out Now") %}
{% set artist = release.artist or "Harald Revery" %}
{% set ogType = "music.song" if release.type == "Single" else "music.album" %}
{% set genres = release.genres or [] %}
{% set s = release.streaming or {} %}
{% set hasStreaming = s.spotify or s.apple or s.soundcloud or s.tidal or s.deezer or s.amazon or s.youtube or s.odysee %}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/prose.css">

    <!-- ====================================================================== -->
    <!-- Page title + SEO (generated from input_release/*.json)                 -->
    <!-- ====================================================================== -->
    <title>Harald Revery - {{ release.name }}</title>
    <meta name="description" content="{{ release.introduction }}">
    <meta name="keywords" content="Harald Revery, {{ release.name }}, {{ release.type }}{% if genres.length %}, {{ genres | join(', ') }}{% endif %}{% if release.isrc %}, ISRC {{ release.isrc }}{% endif %}">

    <!-- Preload LCP assets -->
    <link rel="preload" href="/fonts/HaraldReveryTextFont.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/HaraldReveryMonoFont.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ release.artcoverMin }}" as="image">

    <!--  Open Graph (social media share card) -->
    <meta property="og:title" content="{{ release.name }} — Harald Revery" />
    <meta property="og:description" content="{{ release.introduction }}" />
    <meta property="og:image" content="https://haraldrevery.com{{ release.artcover }}" />
    <meta property="og:url" content="https://haraldrevery.com{{ release.url | cleanUrl }}" />
    <meta property="og:type" content="{{ ogType }}" />
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://haraldrevery.com{{ release.url | cleanUrl }}">

    <!-- Feed autodiscovery. This page does not use eleventy_settings/base.njk,
         so it carries its own copy of base.njk's tag -- keep the two in step. -->
    <link rel="alternate" type="application/rss+xml" title="Harald Revery" href="https://haraldrevery.com/feed.xml">


    <!-- Structured data (MusicAlbum) generated from input_release/*.json -->
    <script type="application/ld+json">{{ release | musicAlbumLd | safe }}</script>

    <!-- Internet icon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="shortcut icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#171717">


    <!-- Release-page styling lives in input.css (.release-*, .cover-3d*, .track*), compiled to main.css. -->

</head>

<body class="min-h-screen text-black dark:text-white">

{% set navScroll = true %}{% include "nav.njk" %}

<!-- svg background start -->
<div class="bg-topology-map">

<!-- ====================================================================== -->
<!-- AMBIENT FULL-BLEED HERO                                                  -->
<!-- ====================================================================== -->
<section class="release-hero">

    <div class="release-hero__backdrop" style="background-image: url('{{ release.artcoverMin }}');"></div>
    <div class="release-hero__scrim"></div>

    <div class="page-container release-hero__inner">

        <div class="release-hero__grid">

            <!-- Crisp cover art — clicking opens the GLightbox slider. -->
            <div class="cover-3d-scene">
                <a href="{{ release.artcover }}"
                   class="glightbox cover-3d bg-neutral-100 dark:bg-neutral-800 cursor-pointer"
                   data-gallery="release-gallery"
                   data-title="{{ release.name }} | ISRC: {{ release.isrc }}">
                    <img src="{{ release.artcoverMin }}"
                         alt="{{ release.name }} cover art | ISRC: {{ release.isrc }}"
                         class="object-cover w-full h-full"
                         width="1080" height="1080">
                </a>
            </div>

            <!-- Title block -->
            <div>
                <p class="release-hero__kicker">{{ kicker }}</p>

                <h1 class="release-hero__title">{{ release.name }}</h1>
                <p class="release-hero__tagline">{{ release.introduction }}</p>

                {% if genres.length %}
                <div class="release-hero__chips">
                    {% for g in genres %}<span>{{ g }}</span>{% endfor %}
                </div>
                {% endif %}

                {% if release.audio or hasStreaming %}
                <a href="#listen" class="release-hero__cta">
                    <svg fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5v11a.5.5 0 0 0 .77.42l8.5-5.5a.5.5 0 0 0 0-.84l-8.5-5.5A.5.5 0 0 0 3 2.5z"/></svg>
                    Listen now
                </a>
                {% endif %}
            </div>

        </div>
    </div>
</section>


<!-- ====================================================================== -->
<!-- Everything below sits in the normal page column.                       -->
<!-- ====================================================================== -->
<div class="page-container extra_fade_effect" style="position: relative; z-index: 1;">

    <!-- ============ RELEASE DETAILS: liner-notes + audio + streaming ============ -->
    <section id="listen" style="scroll-margin-top: 6rem;" class="release-section">

        <div class="release-divider">
            <span class="release-divider__label">Release Details</span>
            <span class="release-divider__line"></span>
        </div>

        <div class="release-two-col">

            <!-- Liner-notes spec sheet -->
            <dl class="release-meta">
                <div class="release-meta__row"><dt>Artist</dt><dd>{{ artist }}</dd></div>
                <div class="release-meta__row"><dt>Type</dt><dd>{{ release.type }}</dd></div>
                <div class="release-meta__row"><dt>Released</dt><dd><time datetime="{{ release.date }}">{{ release.date | readableDate }}</time></dd></div>
                {% if genres.length %}<div class="release-meta__row"><dt>Genre</dt><dd>{{ genres | join(', ') }}</dd></div>{% endif %}
                {% if release.isrc %}<div class="release-meta__row"><dt>ISRC</dt><dd>{{ release.isrc }}</dd></div>{% endif %}
            </dl>

            {% if release.audio or hasStreaming %}
            <!-- Frosted-glass preview panel: audio previews + streaming links. -->
            <div class="preview-card">

                {% if release.audio %}
                {% for a in release.audio %}
                <p class="font-mono text-xs uppercase tracking-eyebrow opacity-50 {% if not loop.first %}mt-6 {% endif %}mb-3">{{ a.label }}</p>
                <audio controls preload="none" class="w-full">
                    <source src="{{ a.src }}" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
                {% endfor %}
                {% endif %}

                {% if hasStreaming %}
                {% if release.audio %}<div class="preview-card__divider"></div>{% endif %}
                <p class="font-mono text-xs uppercase tracking-eyebrow opacity-50 mb-4">Listen everywhere</p>
                <div class="flex flex-wrap items-center gap-6">

                    {% if s.spotify %}
                    <a class="logo-item transition duration-300 hover:opacity-50" href="{{ s.spotify }}" target="_blank" rel="noreferrer">
