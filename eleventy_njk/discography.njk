---
permalink: "discography.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">

    <title>Harald Revery - Discography</title>
    <meta name="description" content="Every Harald Revery music release — singles, EPs and albums — in one place.">
    <meta name="keywords" content="Harald Revery, discography, releases, singles, EP, album, electronic music">

    <link rel="preload" href="/fonts/HaraldReveryTextFont.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/HaraldReveryMonoFont.woff2" as="font" type="font/woff2" crossorigin>

    <meta property="og:title" content="Discography — Harald Revery" />
    <meta property="og:description" content="Every Harald Revery release in one place." />
    <meta property="og:image" content="https://haraldrevery.com/opengraphimg.jpg" />
    <meta property="og:url" content="https://haraldrevery.com/discography" />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://haraldrevery.com/discography">

    <!-- Feed autodiscovery. This page does not use eleventy_settings/base.njk,
         so it carries its own copy of base.njk's tag -- keep the two in step. -->
    <link rel="alternate" type="application/rss+xml" title="Harald Revery" href="https://haraldrevery.com/feed.xml">


    <!-- Structured data: breadcrumb + CollectionPage listing every release -->
    <script type="application/ld+json">{{ collections.releases | discographyLd | safe }}</script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="shortcut icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#171717">

    <!-- Discography grid styling lives in input.css (.disc-tile*), compiled to main.css. -->

</head>

<body class="min-h-screen text-black dark:text-white">

{% include "nav.njk" %}

<!-- svg background start -->
<div class="bg-topology-map">

<!-- Hero -->
<section class="py-12 pt-48">
    <div class="page-container extra_fade_effect">
        <p class="font-mono text-sm uppercase tracking-eyebrow opacity-50 mb-4">Discography</p>
        <h1 class="text-4xl md:text-6xl uppercase tracking-wider font-normal">Releases</h1>
        <p class="mt-6 text-lg opacity-70 max-w-2xl">
            Every Harald Revery release, newest first. Tap a cover to open its page —
            liner notes, previews and links to every streaming service.
        </p>
    </div>
</section>

<!-- Release grid -->
<section class="py-12">
    <div class="page-container extra_fade_effect">
        {% if collections.releases.length %}
        <div class="grid grid-cols-3 md:grid-cols-6 gap-4 md:gap-6 relative z-10">
            {% for r in collections.releases %}
            <a href="{{ r.url | cleanUrl }}" class="disc-tile group" aria-label="{{ r.name }} — {{ r.type }}">
                <img src="{{ r.artcoverMin }}" alt="{{ r.name }} cover art" loading="lazy">
                <span class="disc-tile__overlay">
                    <span class="disc-tile__type">{{ r.type }}</span>
                    <span class="disc-tile__name">{{ r.name }}</span>
                    <span class="disc-tile__year">{{ r.year }}</span>
                </span>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <p class="opacity-60 font-mono text-sm uppercase tracking-widest">
            No releases yet — drop a JSON file into <code>input_release/</code>.
        </p>
        {% endif %}
    </div>
</section>

<!-- Footer -->
{% include "footer.njk" %}

<!-- svg background end -->
</div>

</body>
</html>
