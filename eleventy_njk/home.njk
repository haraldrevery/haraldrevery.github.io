<section class="py-16 pt-48">
    <div class="page-container">
        <h1 class="text-4xl md:text-5xl text-neutral-900 dark:text-white mb-8 uppercase tracking-widest">From the Forest to the Mainstage</h1>
        <p class="text-black dark:text-white text-justify text-body">
           Experience the evolution of Scandinavian Melodic House and Techno. From deep, forest-inspired textures to high-energy festival anthems, stay in tune with every new release, catch the latest DJ sets, and explore the stories behind the sound—all in one place.
        </p>
    </div>
</section>









<section class="py-18">
    <div class="page-container">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            

              {# Nine covers off collections.releases: the latest four, then every
                 second release after that (0,1,2,3,4,6,8,10,12). Sourced from
                 input_release/*.json, so a new release re-shuffles this grid. #}
              {% set homeTiles = [0, 1, 2, 3, 4, 6, 8, 10, 12] %}
              {% if collections.releases.length %}
              <div id="music-image-grid" class="grid grid-cols-3 md:grid-cols-3 gap-4 md:gap-6 relative z-10">
                {%- for i in homeTiles %}
                {%- set r = collections.releases[i] %}
                {%- if r %}

      <a href="{{ r.artcover }}"
         class="glightbox group rounded aspect-square bg-neutral-100 dark:bg-neutral-800 grid-item-reveal transition-all duration-500 hover:scale-105 hover:z-20 shadow-lg overflow-hidden cursor-pointer"
         data-title="{{ r.name }}{% if r.isrc and r.isrc != 'none' %} | ISRC: {{ r.isrc }}{% endif %}"
         data-gallery="music-gallery">
        <picture>
            {%- if r.artcoverMobile %}
            <source srcset="{{ r.artcoverMobile }}" media="(max-width: 767px)">
            {%- endif %}

            <img src="{{ r.artcoverMin }}"
                alt="{{ r.name }} cover art{% if r.isrc and r.isrc != 'none' %} | ISRC: {{ r.isrc }}{% endif %}"
                class="object-cover w-full h-full rounded filter group-hover:saturate-100 transition duration-1000 ease-out"
                loading="lazy">
        </picture>
      </a>
                {%- endif %}
                {%- endfor %}

    </div>
              {% endif %}


              

            
            <div class="space-y-6">

                <h2 class="text-4xl text-black dark:text-white uppercase">The Collection</h2>
                <p class="text-black dark:text-white text-justify text-body">
                     Discover the evolution of Harald Revery's soundscape. Tracks tailormade made for unforgettable raves and festivals. Beyond his signature productions lies a collection of singular tracks that capture a wide range of sonics. Whether built for the peak-time dancefloor or a moment of quiet reflection, these pieces are designed to soundtrack the many chapters of life.
                  </p>
  <div class="pt-6">
        <a href="music.html" class="inline-block border-b-2 border-black dark:border-white pb-1 hover:opacity-50 transition text-lg tracking-widest">
          MUSIC →
        </a>
      </div>
            </div>


        </div>
    </div>
</section>

















<section class="py-18">
    <div class="page-container">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            

             <div class="space-y-6 order-2 md:order-1">

                <h2 class="text-4xl text-black dark:text-white uppercase">Behind the symbol</h2>
                <p class="text-black dark:text-white text-justify text-body">
                 Beyond the strobe lights, the deep beats, and the driving melodies lies the vision that brings the rave to life. From the first note to the final drop, discover the artist behind the mixer.
  </p>
  <div class="pt-6">
        <a href="about.html" class="inline-block border-b-2 border-black dark:border-white pb-1 hover:opacity-50 transition text-lg tracking-widest">
          ABOUT →
        </a>
      </div>
            </div>


              

            
            <div class="space-y-6 order-1 md:order-2">



