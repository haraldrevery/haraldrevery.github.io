                  <div class="compass-sway">
                    <img src="/svg/compass.svg" alt="" class="compass-rose"
                         width="957" height="957" loading="lazy" decoding="async">
                  </div>

                </div>
                  </div>






                      


            </div>


        </div>
    </div>
</section>










<section class="py-18">

    <div class="page-container">
        <div class="grid md:grid-cols-2 gap-16 items-center">
                      
                    <div class="space-y-6 order-2 md:order-1">



                      
                          
                            {# The four newest notebook posts. Compact cards - image,
                               title, date - because this column is half-width; the full
                               cards with tags and description live on /notebook.html.
                               No nested .page-container here: it is 75% inside an
                               already-halved column, which the compass could absorb but
                               four cards cannot. #}
                            <div class="extra_fade_effect">
                              <div class="grid grid-cols-2 gap-4 md:gap-6">
                                {%- for post in collections.notebook_posts | limit(4) %}
                                <article class="group">
                                  <a href="{{ post.url }}" class="block">
                                    <div class="aspect-video bg-neutral-200 dark:bg-neutral-800 rounded-lg overflow-hidden mb-3">
                                      {% if post.data.image %}
                                      <img src="{{ post.data.image }}" alt="{{ post.data.title }}"
                                           class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                           loading="lazy" decoding="async">
                                      {% else %}
                                      <div class="w-full h-full flex items-center justify-center text-neutral-400 dark:text-neutral-600">
                                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                      </div>
                                      {% endif %}
                                    </div>
                                    <h3 class="text-base md:text-lg text-zinc-900 dark:text-white mb-2 uppercase tracking-wide leading-snug group-hover:text-neutral-500 dark:group-hover:text-neutral-400 transition-colors">
                                      {{ post.data.title }}
                                    </h3>
                                  </a>
                                  <div class="text-xs text-neutral-500 dark:text-neutral-500 font-mono uppercase tracking-wider">
                                    {{ post.date | readableDate }}
                                  </div>
                                </article>
                                {%- endfor %}
                              </div>
                            </div>
                       




                    </div>

           <div class="space-y-6 order-1 md:order-2">

                          <h2 class="text-4xl text-black dark:text-white uppercase">Reveries</h2>
                          <p class="text-black dark:text-white text-justify text-body">
                          Read the thoughs and ideas, explore the Harald Revery side projects and the other endeavours outside the music.
                        </p>
                      <div class="pt-6">
                          <a href="notebook.html" class="inline-block border-b-2 border-black dark:border-white pb-1 hover:opacity-50 transition text-lg tracking-widest">
                          NOTEBOOK →
                        </a>
                      </div>
            </div>


              

            

