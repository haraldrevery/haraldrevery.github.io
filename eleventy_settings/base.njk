<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css"> 
    <link rel="stylesheet" href="/prose.css">
    
    <title>Harald Revery - {{ title }}</title>
    
    {# SEO Meta Description #}
    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="shortcut icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#171717">
        
    {# Feed autodiscovery: lets a reader (and Firefox/Safari extensions) find
       /feed.xml from any page. Generated by eleventy_njk/feed.njk, which carries
       notebook posts AND music releases. discography.njk and release.njk do not
       use this layout and repeat this tag themselves -- keep the three in step. #}
    <link rel="alternate" type="application/rss+xml" title="Harald Revery" href="https://haraldrevery.com/feed.xml">

    {# Canonical URL #}
    <link rel="canonical" href="https://haraldrevery.com{{ page.url | cleanUrl }}">
    
    <link rel="preload" href="/fonts/HaraldReveryTextFont.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/HaraldReveryMonoFont.woff2" as="font" type="font/woff2" crossorigin>

    {# Share image: absolute URL + intrinsic size, read from the file itself by
       the imageMeta filter so og:image:width/height can never drift from the
       actual asset. width/height are omitted when the size is unreadable. #}
    {% set ogImage = (image or "/opengraphimg.jpg") | imageMeta %}

    {# Open Graph Meta Tags #}
    {# Title shape is "Harald Revery - <page>" everywhere: <title>, og, twitter. #}
    <meta property="og:title" content="Harald Revery - {{ title }}" />
    <meta property="og:url" content="https://haraldrevery.com{{ page.url | cleanUrl }}" />
    <meta property="og:type" content="{% if layout == "post.njk" or date %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="Harald Revery" />
    <meta property="og:locale" content="en_US" />
    {% if description %}
    <meta property="og:description" content="{{ description }}" />
    {% endif %}
    <meta property="og:image" content="{{ ogImage.url }}" />
    {% if ogImage.width %}
    <meta property="og:image:width" content="{{ ogImage.width }}" />
    <meta property="og:image:height" content="{{ ogImage.height }}" />
    {% endif %}
    <meta property="og:image:alt" content="Harald Revery - {{ title }}" />

    {% if layout == "post.njk" or date %}
    <meta property="article:published_time" content="{{ date | isoStamp }}" />
    <meta property="article:modified_time" content="{{ (updated or date) | isoStamp }}" />
    <meta property="article:author" content="https://haraldrevery.com/about" />
    {% endif %}

    {# Twitter Card #}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Harald Revery - {{ title }}" />
    {% if description %}
    <meta name="twitter:description" content="{{ description }}" />
    {% endif %}
    <meta name="twitter:image" content="{{ ogImage.url }}" />
    <meta name="twitter:image:alt" content="Harald Revery - {{ title }}" />

    {# Schema.org structured data for notebook posts. Built by the articleLd
       filter in eleventy.config.js, NOT hand-written here: interpolating
       frontmatter straight into a JSON literal lets Nunjucks autoescaping put
       &quot; inside string values and lets a stray backslash produce invalid
       JSON, which makes Google discard the entire block. #}
    {# `customJsonLd` opts a page out. articleLd is hardcoded to @type Article,
       but page-builder exports (input_build_page/) resolve their own type —
       BlogPosting, ImageGallery or FAQPage — and an FAQ page carries a
       mainEntity list of its questions, which drives rich results and cannot be
       reconstructed from front matter. Those pages emit their own block in the
       body instead; two competing Article entities would be worse than one
       correct one. #}
    {% if (layout == "post.njk" or date) and not customJsonLd %}
    <script type="application/ld+json">
    {{ { title: title, description: description, image: image, date: date, updated: updated, url: page.url } | articleLd | safe }}
    </script>
    {% endif %}
</head>

<body class="min-h-screen text-zinc-900 dark:text-white">

{% include "nav.njk" %}

<div class="bg-topology-map"> 

    {{ content | safe }}







{% include "footer.njk" %}

</div>

{# Pairs with nav.njk's `navScroll`, which adds .navi_mechanic to the header.
   The two MUST travel together: navbar_scroll_min.js does
   querySelector(".navi_mechanic") with no null guard, and without the script
   the Firefox @supports-not fallback never runs, so the hidden nav would never
   come back. Set `navScroll: true` in a page's front matter to opt in. #}
{% if navScroll %}<script src="/javascript/navbar_scroll_min.js" defer></script>{% endif %}
<script src="/javascript/glightbox.min.js" defer></script>
<script src="/javascript/glightbox_settings_min.js" defer></script>

</body>
</html>
