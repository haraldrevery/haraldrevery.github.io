---
layout: base.njk
---
{% from "post_chrome.njk" import postHeader, postEnding %}
{% set dateIso = date | isoStamp %}
{% set dateHuman = date | readableDate %}
{# demoteHeadings first: the <h1> below is this page's only h1, so a body that
   also uses "# Foo" is shifted down a level before ids and the outline are
   derived from it. No-op for a body that already starts at h2. #}
{% set body = content | demoteHeadings | addAnchors %}
{% set outline = body | toc %}

{# Reading-width: apply the saved scale BEFORE .post-container below is parsed,
   so a remembered width never renders full-width and then snaps narrow.
   Same pre-paint pattern as the theme snippet in rvry_ascii.html. The touch
   guard mirrors javascript/reading_width.js, which never builds the button on
   touch devices — without it a stored width would apply with no way to undo it. #}
<script>try{if(!(navigator.maxTouchPoints>0||'ontouchstart' in window)){var w=parseFloat(localStorage.getItem('rvry-reading-width'));if(w>0.1&&w<=1)document.documentElement.style.setProperty('--reading-scale',w);}}catch(e){}</script>

{% if outline %}
{# No-JS article outline: hidden checkbox drives the toggle; visible by default #}
<input type="checkbox" id="article-outline-toggle" class="article-outline-toggle">
<aside class="article-outline-panel">
    <p class="article-outline-heading">On this page</p>
    {{ outline | safe }}
</aside>
<label for="article-outline-toggle" class="article-outline-btn" title="Toggle outline" aria-label="Toggle outline">
    <span class="article-outline-icon-open" aria-hidden="true">E</span>
    <span class="article-outline-icon-close" aria-hidden="true">X</span>
</label>
{% endif %}

<div class="post-container pt-24 pb-12 fade_effect">
    <article class="mx-auto">

        {# The date/title/back-link header and the ending below are shared with
           post_body.njk and the page builder's preview — see post_chrome.njk. #}
        {{ postHeader(title, dateIso, dateHuman) }}

        <div class="prose prose-lg max-w-none text-zinc-900 dark:text-white">
            {{ body | safe }}
        </div>

    </article>
</div>

{{ postEnding(dateIso, dateHuman) }}

{# Reading-width toggle button (JS injects it; absent = no button, no effect) #}
<script src="/javascript/reading_width.js" defer></script>
